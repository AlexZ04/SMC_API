<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="005-create-subscription" author="aleksey.z">
        <createTable tableName="subscription">
            <column name="user_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="subscribed_to_event_distribution" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="subscribed_to_competition_distribution" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="subscribed_to_schedule_distribution" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="subscription"
                baseColumnNames="user_id"
                constraintName="fk_subscription_user"
                referencedTableName="bot_user"
                referencedColumnNames="inner_id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
