<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="016-create-giveaway-participant" author="aleksey.z">
        <createTable tableName="giveaway_participant">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="participant_number" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="create_time" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="giveaway_participant"
                columnNames="user_id"
                constraintName="uc_giveaway_participant_user_id"/>

        <addForeignKeyConstraint
                baseTableName="giveaway_participant"
                baseColumnNames="user_id"
                constraintName="fk_giveaway_participant_user"
                referencedTableName="bot_user"
                referencedColumnNames="inner_id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
