<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="017-add-bot-stats-message-user-sent" author="aleksey.z">
        <addColumn tableName="bot_stats">
            <column name="message_user_sent" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="bot_stats">
            <column name="message_user_sent" valueComputed="(select count(*) from message_history)"/>
        </update>
    </changeSet>

</databaseChangeLog>
